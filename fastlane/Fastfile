default_platform(:ios)

APP_IDENTIFIER = "com.burillab.app"
IOS_PROJECT = "ios/App/App.xcodeproj"
IOS_SCHEME = "App"
PROFILE_NAME = "match AppStore #{APP_IDENTIFIER}"
OUTPUT_DIR = "fastlane/build"
OUTPUT_NAME = "BurilLab.ipa"

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Create or repair App Store signing assets in the private match repository"
  lane :bootstrap_signing do
    validate_release_env!(require_match: true)
    api_key = load_app_store_key

    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_basic_authorization: optional_env("MATCH_GIT_BASIC_AUTHORIZATION"),
      readonly: false,
      api_key: api_key
    )
  end

  desc "Build Buril Lab and upload it to TestFlight"
  lane :testflight do
    validate_release_env!(require_match: true)
    api_key = load_app_store_key

    bootstrap_signing = truthy?(ENV["BOOTSTRAP_SIGNING"])
    marketing_version = optional_env("IOS_MARKETING_VERSION")
    build_number = optional_env("IOS_BUILD_NUMBER") || ENV["GITHUB_RUN_NUMBER"] || Time.now.utc.strftime("%Y%m%d%H%M")
    changelog = optional_env("TESTFLIGHT_CHANGELOG") || "Automated TestFlight build from GitHub Actions."
    external_beta = truthy?(ENV["TESTFLIGHT_EXTERNAL_BETA"])

    sh("xcodebuild -version")

    increment_version_number(
      xcodeproj: IOS_PROJECT,
      version_number: marketing_version
    ) if marketing_version

    increment_build_number(
      xcodeproj: IOS_PROJECT,
      build_number: build_number
    )

    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_basic_authorization: optional_env("MATCH_GIT_BASIC_AUTHORIZATION"),
      readonly: !bootstrap_signing,
      api_key: api_key
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: IOS_PROJECT,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier: APP_IDENTIFIER,
      profile_name: PROFILE_NAME,
      code_sign_identity: "Apple Distribution",
      targets: [IOS_SCHEME]
    )

    ipa_path = build_app(
      project: IOS_PROJECT,
      scheme: IOS_SCHEME,
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          APP_IDENTIFIER => PROFILE_NAME
        }
      },
      output_directory: OUTPUT_DIR,
      output_name: OUTPUT_NAME,
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch("APPLE_TEAM_ID")}"
    )

    upload_options = {
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: ipa_path,
      changelog: changelog,
      uses_non_exempt_encryption: false,
      skip_waiting_for_build_processing: false
    }

    if external_beta
      upload_options.merge!(
        distribute_external: true,
        groups: [optional_env("TESTFLIGHT_EXTERNAL_GROUP") || "External Testers"],
        notify_external_testers: truthy?(optional_env("TESTFLIGHT_NOTIFY_EXTERNAL_TESTERS") || "true"),
        submit_beta_review: true,
        beta_app_review_info: beta_review_info,
        localized_app_info: localized_app_info,
        localized_build_info: {
          "default" => {
            whats_new: changelog
          }
        }
      )
    end

    upload_to_testflight(upload_options)
  end

  private_lane :load_app_store_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_CONTENT_BASE64"),
      is_key_content_base64: true,
      duration: 1200,
      in_house: false
    )
  end
end

def beta_review_info
  {
    contact_email: ENV.fetch("BETA_REVIEW_CONTACT_EMAIL"),
    contact_first_name: ENV.fetch("BETA_REVIEW_CONTACT_FIRST_NAME"),
    contact_last_name: ENV.fetch("BETA_REVIEW_CONTACT_LAST_NAME"),
    contact_phone: ENV.fetch("BETA_REVIEW_CONTACT_PHONE"),
    demo_account_name: optional_env("BETA_DEMO_ACCOUNT_NAME"),
    demo_account_password: optional_env("BETA_DEMO_ACCOUNT_PASSWORD"),
    notes: optional_env("BETA_REVIEW_NOTES") || "Buril Lab is a laboratory reagent inventory and safety workflow app. Camera access is used for reagent label scanning and cabinet photos. Microphone access is used only when the user opens the voice assistant."
  }.compact
end

def localized_app_info
  {
    "default" => {
      feedback_email: ENV.fetch("BETA_REVIEW_CONTACT_EMAIL"),
      privacy_policy_url: ENV.fetch("BETA_PRIVACY_POLICY_URL"),
      marketing_url: optional_env("BETA_MARKETING_URL"),
      description: optional_env("BETA_DESCRIPTION") || "Buril Lab helps labs manage reagent inventory, cabinet photos, safety searches, and shared lab workflows."
    }.compact
  }
end

def validate_release_env!(require_match:)
  required = %w[
    APPLE_TEAM_ID
    APP_STORE_CONNECT_KEY_ID
    APP_STORE_CONNECT_ISSUER_ID
    APP_STORE_CONNECT_KEY_CONTENT_BASE64
  ]
  required += %w[MATCH_GIT_URL MATCH_GIT_BASIC_AUTHORIZATION MATCH_PASSWORD] if require_match

  missing = required.select { |key| optional_env(key).nil? }
  UI.user_error!("Missing required environment variables: #{missing.join(", ")}") unless missing.empty?

  return unless truthy?(ENV["TESTFLIGHT_EXTERNAL_BETA"])

  external_required = %w[
    BETA_REVIEW_CONTACT_EMAIL
    BETA_REVIEW_CONTACT_FIRST_NAME
    BETA_REVIEW_CONTACT_LAST_NAME
    BETA_REVIEW_CONTACT_PHONE
    BETA_PRIVACY_POLICY_URL
  ]
  external_missing = external_required.select { |key| optional_env(key).nil? }
  UI.user_error!("Missing external TestFlight metadata variables: #{external_missing.join(", ")}") unless external_missing.empty?
end

def optional_env(key)
  value = ENV[key]
  value && !value.strip.empty? ? value : nil
end

def truthy?(value)
  %w[1 true yes y on].include?(value.to_s.strip.downcase)
end
