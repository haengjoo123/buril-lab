{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "buril-lab",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "upload_source_maps": true,
  "kv_namespaces": [
    {
      "binding": "BURILLAB_RUNTIME_CONFIG",
      "id": "__BURILLAB_PRODUCTION_RUNTIME_CONFIG_KV_ID__"
    }
  ],
  "vars": {
    "APP_ENVIRONMENT": "production",
    "PUBLIC_APP_ORIGIN": "https://burillab.com",
    "OPENAI_RESPONSES_MODEL": "gpt-5.6-luna",
    "OPENAI_STT_MODEL": "gpt-transcribe",
    "OPENAI_TTS_MODEL": "gpt-4o-mini-tts",
    "OPENAI_TTS_VOICE": "alloy",
    "OPENAI_AUDIO_ENABLED": "true"
  },
  "env": {
    "preview": {
      "kv_namespaces": [],
      "vars": {
        "APP_ENVIRONMENT": "production-preview-disabled",
        "PUBLIC_APP_ORIGIN": "https://burillab.com",
        "OPENAI_RESPONSES_MODEL": "gpt-5.6-luna",
        "OPENAI_STT_MODEL": "gpt-transcribe",
        "OPENAI_TTS_MODEL": "gpt-4o-mini-tts",
        "OPENAI_TTS_VOICE": "alloy",
        "OPENAI_AUDIO_ENABLED": "true"
      }
    }
  }
}
