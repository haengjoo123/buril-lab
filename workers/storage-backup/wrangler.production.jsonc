{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "buril-lab-storage-backup-production",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "limits": {
    "subrequests": 4000
  },
  "secrets": {
    "required": ["SUPABASE_SERVICE_ROLE_KEY"]
  },
  "triggers": {
    "crons": ["45 17 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "BURILLAB_RUNTIME_CONFIG",
      "id": "dd6866f35f794a91b0fb5a24cbe57cf3"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CABINET_BACKUPS",
      "bucket_name": "buril-lab-cabinet-backups-production"
    }
  ],
  "vars": {
    "BACKUP_ENVIRONMENT": "production",
    "SUPABASE_PROJECT_REF": "zafxzidbtbryiksemlwc",
    "SUPABASE_URL": "https://zafxzidbtbryiksemlwc.supabase.co",
    "SOURCE_POINTER_MODE": "legacy_url",
    "SOURCE_STORAGE_BUCKET": "cabinets",
    "WORKERS_SUBREQUEST_LIMIT": "4000",
    "WORKERS_USAGE_PLAN": "paid"
  }
}
