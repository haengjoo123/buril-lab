{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "buril-lab-storage-backup-staging-acceptance-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "upload_source_maps": false,
  "limits": {
    "subrequests": 4000
  },
  "secrets": {
    "required": ["SUPABASE_SERVICE_ROLE_KEY"]
  },
  "kv_namespaces": [
    {
      "binding": "BURILLAB_RUNTIME_CONFIG",
      "id": "dcaa52254fa6447bbe7c21f54354ad0d",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "CABINET_BACKUPS",
      "bucket_name": "buril-lab-cabinet-backups-staging",
      "remote": true
    }
  ],
  "vars": {
    "BACKUP_ENVIRONMENT": "staging",
    "SUPABASE_PROJECT_REF": "qpgnomuqdcucjmxrunnw",
    "SUPABASE_URL": "https://qpgnomuqdcucjmxrunnw.supabase.co",
    "SOURCE_POINTER_MODE": "legacy_url",
    "SOURCE_STORAGE_BUCKET": "cabinets",
    "WORKERS_SUBREQUEST_LIMIT": "4000",
    "WORKERS_USAGE_PLAN": "paid"
  }
}
