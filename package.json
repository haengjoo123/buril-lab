{
  "name": "buril-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "assets:generate": "node scripts/generate-app-assets.mjs",
    "assets:capacitor": "npx @capacitor/assets generate --ios --android --assetPath resources --iconBackgroundColor \"#0f172a\" --iconBackgroundColorDark \"#0f172a\" --splashBackgroundColor \"#0f172a\" --splashBackgroundColorDark \"#0f172a\"",
    "build": "npm run ph:verify-release && npm run golden:verify && tsc -b && vite build && node scripts/verify-no-client-secrets.mjs",
    "security:client-secrets": "node scripts/verify-no-client-secrets.mjs",
    "ph:verify-sources": "node scripts/verify-ph-catalog-sources.mjs",
    "ph:verify-release": "vitest run src/features/phPrediction/catalogApproval.test.ts src/features/phPrediction/predictor.test.ts --reporter=dot",
    "golden:generate": "node scripts/generate-waste-golden-v2.mjs",
    "golden:refresh-labels": "node scripts/refresh-waste-golden-v2-labels.mjs",
    "golden:refresh-evidence": "node scripts/refresh-waste-golden-v2-evidence.mjs",
    "golden:store-adjudication": "node scripts/store-waste-golden-v2-adjudication.mjs",
    "golden:reconcile-ready-streams": "node scripts/reconcile-waste-golden-v2-ready-streams.mjs",
    "golden:reconcile-scenario-evidence": "node scripts/reconcile-waste-golden-v2-scenario-evidence.mjs",
    "golden:reclassify": "node scripts/reclassify-waste-golden-v2.mjs",
    "golden:apply-baseline-corrections": "node scripts/apply-waste-golden-v2-baseline-corrections.mjs",
    "golden:verify": "vitest run scripts/waste-golden-v2.test.ts --reporter=dot",
    "golden:report": "node scripts/write-waste-golden-v2-report.mjs",
    "build:android": "npm run build && npx cap sync android",
    "build:ios": "npm run build && npx cap sync ios && npm run capacitor:normalize-ios-spm",
    "android:open": "npx cap open android",
    "android:sync": "npx cap sync android",
    "android:run": "npm run build:android && npx cap run android",
    "ios:open": "npx cap open ios",
    "ios:sync": "npx cap sync ios && npm run capacitor:normalize-ios-spm",
    "capacitor:normalize-ios-spm": "node scripts/normalize-capacitor-ios-spm.mjs",
    "ios:run": "npm run build:ios && npx cap run ios",
    "lint": "eslint .",
    "test": "vitest run",
    "test:chemical-live": "node scripts/run-chemical-live-smoke.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.1",
    "@react-spring/three": "^10.0.3",
    "@react-spring/web": "^10.0.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@supabase/supabase-js": "^2.93.3",
    "@types/three": "^0.183.1",
    "@types/uuid": "^10.0.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@use-gesture/react": "^10.3.1",
    "axios": "^1.17.0",
    "cheerio": "^1.2.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.8.0",
    "html2pdf.js": "^0.14.0",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "jose": "^6.2.2",
    "lucide-react": "^0.562.0",
    "openai": "^6.34.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.17.0",
    "react-webcam": "^7.2.0",
    "three": "^0.183.2",
    "uuid": "^14.0.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.15",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.8"
  }
}
