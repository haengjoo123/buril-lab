# Explicit client allowlist
# These values are bundled into web, Android, and iOS apps. Never add API keys,
# service-role credentials, JWT secrets, or tokens with a VITE_ prefix.
VITE_PUBLIC_APP_URL=https://your-app.example.com
VITE_INTERNAL_API_BASE_URL=https://your-app.example.com
VITE_AUTH_REDIRECT_URL=https://your-app.example.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Waste V2 is active globally. Set exactly `false` only for an emergency
# rollback while a corrective deployment is prepared.
VITE_ENABLE_WASTE_V2=true
# Evidence-approved pH records are on by default. Set exactly `false` only for
# an emergency rollback; this flag cannot override failed scientific gates.
VITE_ENABLE_PH_PREDICTION=true
# Unified server-side PubChem/KOSHA/pH enrichment is on by default. Set exactly
# `false` only for an emergency rollback to the legacy direct lookup path.
VITE_ENABLE_CHEMICAL_ENRICHMENT=true
# Submitted-search analytics is disabled until its reviewed privacy/admin path
# is ready. Enable only through an explicit, reviewed deployment change.
VITE_ENABLE_SEARCH_ANALYTICS=false

# Cloudflare Pages Functions server secrets
# Configure these in Cloudflare, not in client builds.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
OPS_ADMIN_EMAILS=developer@example.com
FEEDBACK_ADMIN_EMAILS=developer@example.com
OPS_ANALYTICS_EXPORT_EMAILS=developer@example.com

KOSHA_API_KEY=your-kosha-api-key

OPENAI_API_KEY=your-openai-api-key
OPENAI_SAFETY_HMAC_SECRET=generate-at-least-32-random-bytes
OPENAI_RESPONSES_MODEL=gpt-5.6-luna
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_AUDIO_ENABLED=true

UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# GitHub environment deployment inputs (set separately in `staging` and
# `production`; never commit their real values). Staging and production must
# use different Supabase projects and runtime-config KV namespace IDs.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-environment-scoped-pages-api-token
BURILLAB_RUNTIME_CONFIG_KV_ID=your-environment-runtime-config-kv-id
SUPABASE_ACCESS_TOKEN=your-environment-scoped-supabase-access-token
SUPABASE_PROJECT_REF=your-environment-supabase-project-ref
STAGING_ACCESS_CLIENT_ID=your-staging-access-service-token-id
STAGING_ACCESS_CLIENT_SECRET=your-staging-access-service-token-secret
# Staging environment only: synthetic Gate 0 fixture credentials. The seed
# confirmation is a target lock, not a secret, and must match exactly.
STAGING_SUPABASE_SERVICE_ROLE_KEY=your-staging-supabase-service-role-key
GATE0_E2E_EMAIL=gate0-browser@example.invalid
GATE0_E2E_PASSWORD=use-a-unique-20-character-minimum-password
GATE0_STAGING_SEED_CONFIRMATION=SEED GATE0 SYNTHETIC DATA qpgnomuqdcucjmxrunnw
